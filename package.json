{
  "name": "edge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "+EV-analys för Stryktipset, Europatipset och V75",
  "scripts": {
    "capture": "node --env-file-if-exists=.env node_modules/.bin/tsx scripts/capture.ts",
    "import-archive": "node --env-file-if-exists=.env node_modules/.bin/tsx scripts/import-archive.ts",
    "calibrate": "node --env-file-if-exists=.env node_modules/.bin/tsx scripts/calibrate-alpha.ts",
    "backtest": "node --env-file-if-exists=.env node_modules/.bin/tsx scripts/backtest.ts",
    "db:push": "node --env-file-if-exists=.env node_modules/.bin/drizzle-kit push",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "analyse": "node --env-file-if-exists=.env node_modules/.bin/tsx scripts/analyse.ts",
    "fetch-results": "node --env-file-if-exists=.env node_modules/.bin/tsx scripts/fetch-results.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "drizzle-orm": "^0.45.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
